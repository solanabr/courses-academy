[
  {
    "id": "t1",
    "description": "caret admits minor and patch walks inside the major: 7.1.2 satisfies ^7.0.0",
    "input": "'7.1.2', '^7.0.0'",
    "expectedOutput": "result === true"
  },
  {
    "id": "t2",
    "description": "a new major breaks the caret: 8.2.0 does NOT satisfy ^7.0.0",
    "input": "'8.2.0', '^7.0.0'",
    "expectedOutput": "result === false"
  },
  {
    "id": "t3",
    "description": "tilde admits patch walks: 1.2.9 satisfies ~1.2.3",
    "input": "'1.2.9', '~1.2.3'",
    "expectedOutput": "result === true"
  },
  {
    "id": "t4",
    "description": "tilde stops at the minor: 1.3.0 does NOT satisfy ~1.2.3",
    "input": "'1.3.0', '~1.2.3'",
    "expectedOutput": "result === false"
  },
  {
    "id": "t5",
    "description": "caret-zero rule, patch side: 0.3.10 satisfies ^0.3.9",
    "input": "'0.3.10', '^0.3.9'",
    "expectedOutput": "result === true"
  },
  {
    "id": "t6",
    "description": "caret-zero rule, breaking side: 0.4.0 does NOT satisfy ^0.3.9, under major 0 the minor is the breaking slot",
    "input": "'0.4.0', '^0.3.9'",
    "expectedOutput": "result === false"
  },
  {
    "id": "t7",
    "description": ">= floors at the base: 6.9.0 satisfies >=6.4.0",
    "input": "'6.9.0', '>=6.4.0'",
    "expectedOutput": "result === true"
  },
  {
    "id": "t8",
    "description": ">= rejects below the base: 6.3.9 does NOT satisfy >=6.4.0",
    "input": "'6.3.9', '>=6.4.0'",
    "expectedOutput": "result === false"
  },
  {
    "id": "t9",
    "description": "a bare version is an exact pin: 24.20.0 satisfies 24.20.0",
    "input": "'24.20.0', '24.20.0'",
    "expectedOutput": "result === true"
  },
  {
    "id": "t10",
    "description": "the peer-conflict case from the lab: 7.0.2 does NOT satisfy a ^6.9.0 peer range",
    "input": "'7.0.2', '^6.9.0'",
    "expectedOutput": "result === false"
  },
  {
    "id": "t11",
    "description": "caret still floors at its base: 6.8.0 does NOT satisfy ^6.9.0",
    "input": "'6.8.0', '^6.9.0'",
    "expectedOutput": "result === false"
  }
]
